# Trading desk — box 1 (145.241.193.169). Add this block to /etc/caddy/Caddyfile alongside the
# orderbook / risk / admin blocks. The desk serves the shell and reverse-proxies its two
# upstreams itself, so Caddy only fronts one upstream here. flush_interval -1 keeps the proxied
# SSE streams unbuffered end to end.
desk.damianhoward.com {
	# Baseline hardening on every response. frame-ancestors is 'self', not 'none', because the
	# desk's own tabs are same-origin iframes served through its gateway.
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "frame-ancestors 'self'"
	}
	# The desk is where a desk visitor actually is. Without this log its traffic was invisible to
	# visitor-analytics, while the desk's own server-side hop to trading.damianhoward.com showed
	# up in box 2's log as a visit from this box. Logging here attributes the visit to the real
	# client, and the tab is legible from the path prefix.
	log {
		output file /var/log/caddy/desk.log {
			mode 0644
		}
		format json
	}
	reverse_proxy localhost:8084 {
		flush_interval -1
	}
}
